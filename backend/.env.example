# 复制成 .env 后填写。.env 已被 .gitignore 排除，**永远不会进仓库**。
# 千万不要把真实密钥写进代码、README、测试或 commit message。

# ---------------- 数据源 ----------------
# mock: 假数据（前端联调 / demo 兜底）
# real: 真实 API
VISION_PROVIDER=mock

# ---------------- 真实视觉 API ----------------
VISION_API_URL=
VISION_API_KEY=
# frame: 单帧同步 ｜ segment: 片段
VISION_API_MODE=frame
# json_b64 | json_b64_list | raw
VISION_PAYLOAD=json_b64
VISION_TIMEOUT=2.5
VISION_SEGMENT_SECONDS=12

# 字段路径映射，| 分隔多个候选。对不上再改。
# VISION_FIELD_HR=data.heart_rate|data.hr
# VISION_FIELD_RR=data.breath_rate
# VISION_FIELD_QUALITY=data.quality
# VISION_FIELD_FACES=data.face_count

VISION_HR_RANGE=40-180
VISION_RR_RANGE=4-60
VISION_AUTH_HEADER=Authorization
# 注意这里要带引号，否则尾部的空格会被吃掉，鉴权头变成 "Bearerxxx"
VISION_AUTH_PREFIX="Bearer "

# ---------------- 实时语音接口 ----------------
VOICE_API_URL=
VOICE_API_KEY=
# 是否返回逐词时间戳 —— 没有它就算不出停顿和语速，双确认会塌一半
VOICE_WORD_TIMESTAMPS=0

# ---------------- 引擎参数 ----------------
BASELINE_SECONDS=60
BASELINE_MIN_SAMPLES=8
SAMPLE_MIN_INTERVAL=2.0
PROBE_THRESHOLD=1.5
BEHAVIOR_THRESHOLD=0.5
HINT_COOLDOWN=30
MIN_QUALITY=0.15

# ---------------- Mock 排练用 ----------------
# 这些时间段模拟负荷升高，方便排练 demo
MOCK_STRESS_WINDOWS=25-40,85-100

# ---------------- 语音转写（ASR，阿里云百炼 DashScope）----------------
# 浏览器自带的识别直连 Google，国内不通，所以 ASR 放服务端。
# 关掉或没配 key 时前端自动退回手打输入，纪要功能不受影响。
STT_ENABLED=0
STT_API_KEY=
STT_MODEL=qwen3-asr-flash
# 临时文件目录（留空用系统临时目录）
STT_TMP_DIR=

# ---------------- LLM：负责"分析"（语义判断 / 写追问 / 写总结）----------------
# 关闭或没配 key 时，整条链自动退回模板，不会报错。
LLM_ENABLED=0
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=8

# FacePhys 凭据只填入本机或服务器的 .env；此示例不能放真实值。
TTC_API_KEY_ID=
TTC_API_SECRET=
TTC_API_BASE=

# ---------------- 简历投递 / 智能初筛 ----------------
# 只在本机演示启用：企业端免登录，候选人任意账号密码进入。
RECRUITMENT_DEMO_MODE=0
# 仅服务器读取；真实密钥只填写在本机 .env 或部署环境，不写入源码。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
SCREENING_TIMEOUT=90
HR_REGISTRATION_CODE=
TTC_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500
RECRUITMENT_DATA_DIR=
RECRUITMENT_RETENTION_DAYS=365
# AI 初面邀请有效期（天）。过期后企业端显示「已过期」，可重发并顺延。
AI_INVITE_DAYS=7
# 真人面试邀请在面试时间之后的有效期（天）。
HUMAN_INVITE_DAYS=3
# Existing Node AI voice service stays on loopback; these ports must match.
INTERVIEW_API_PORT=8787
INTERVIEW_SIDECAR_URL=http://127.0.0.1:8787
