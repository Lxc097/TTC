# 复制成 .env 后填写。.env 已被 .gitignore 排除，**永远不会进仓库**。
# 千万不要把真实密钥写进代码、README、测试或 commit message。

# ---------------- 数据源 ----------------
# mock: 假数据（前端联调 / demo 兜底）
# real: 真实 API
VISION_PROVIDER=mock

# ---------------- 真实视觉 API ----------------
VISION_API_URL=
VISION_API_KEY=
# frame: 单帧同步 ｜ segment: 片段
VISION_API_MODE=frame
# json_b64 | json_b64_list | raw
VISION_PAYLOAD=json_b64
VISION_TIMEOUT=2.5
VISION_SEGMENT_SECONDS=12

# 字段路径映射，| 分隔多个候选。对不上再改。
# VISION_FIELD_HR=data.heart_rate|data.hr
# VISION_FIELD_RR=data.breath_rate
# VISION_FIELD_QUALITY=data.quality
# VISION_FIELD_FACES=data.face_count

VISION_HR_RANGE=40-180
VISION_RR_RANGE=4-60
VISION_AUTH_HEADER=Authorization
# 注意这里要带引号，否则尾部的空格会被吃掉，鉴权头变成 "Bearerxxx"
VISION_AUTH_PREFIX="Bearer "

# ---------------- 实时语音接口 ----------------
VOICE_API_URL=
VOICE_API_KEY=
# 是否返回逐词时间戳 —— 没有它就算不出停顿和语速，双确认会塌一半
VOICE_WORD_TIMESTAMPS=0

# ---------------- 引擎参数 ----------------
BASELINE_SECONDS=60
BASELINE_MIN_SAMPLES=8
SAMPLE_MIN_INTERVAL=2.0
PROBE_THRESHOLD=1.5
BEHAVIOR_THRESHOLD=0.5
HINT_COOLDOWN=30
MIN_QUALITY=0.5

# ---------------- Mock 排练用 ----------------
# 这些时间段模拟负荷升高，方便排练 demo
MOCK_STRESS_WINDOWS=25-40,85-100

# ---------------- 报告 ----------------
LLM_ENABLED=0
LLM_SUMMARY_URL=
